{
  "name": "@tabburrow/extension",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-env.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prebuild": "node scripts/sync-env.mjs",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "make-icons": "node scripts/make-icons.mjs",
    "sync-env": "node scripts/sync-env.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "capture-assets": "tsx e2e/capture-assets.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.110.5",
    "@tabburrow/core": "workspace:*",
    "@tabburrow/ui": "workspace:*",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^4.4.0",
    "fuzzysort": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^14.12.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "wxt": "^0.20.27"
  }
}
