# Supabase (hosted or self-hosted project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Google OAuth for Supabase Auth's Google sign-in (extension's Settings ->
# Account). Not read from this file by any app code: for a hosted project,
# set the client id/secret in the Supabase Dashboard directly; for the local
# CLI stack, `supabase/config.toml` reads these as `env(...)` references, so
# `export` them into the shell `supabase start` runs from. See the full
# console + config steps in docs/SETUP_NOTES.md.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# web app (apps/web/lib/share.ts, T21b share pages) + functions only, never
# the extension. apps/web reads SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY
# straight from process.env at request time (Next.js server code, not a
# build-time inject like the extension's WXT_SUPABASE_* vars below); set
# them wherever the web app actually runs (apps/web/.env.local for local
# dev, or the host platform's env config in production).
SUPABASE_SERVICE_ROLE_KEY=
# AI organize (self-hosters use their own key)
ANTHROPIC_API_KEY=
# Stripe (test mode). checkout-session/stripe-webhook Edge Functions read
# these via `supabase secrets set` (hosted) or `--env-file` (local), never
# straight from this file — see SELF_HOSTING.md's "Set secrets" section.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=        # $4/mo price id
STRIPE_PRICE_YEARLY=         # $29/yr price id
# checkout-session's own copy of the site URL, for building success_url/
# cancel_url/return_url. Edge Functions read Deno.env, not apps/web's
# NEXT_PUBLIC_SITE_URL below (different runtime, different process) — set
# to the SAME logical value via `supabase secrets set SITE_URL=...`
# (hosted) or an --env-file (local), never picked up from this file
# automatically.
SITE_URL=http://localhost:3000
# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# apps/web only (T23a): browser-side Supabase client for /account (email
# OTP sign-in + billing). Same project as SUPABASE_URL/SUPABASE_ANON_KEY
# above but NEXT_PUBLIC_-prefixed so Next.js inlines it into the client
# bundle; set in apps/web/.env.local for local dev (or your host's env
# config in production) alongside SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY.
# Anon key only, never the service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
