# Supabase (hosted or self-hosted project)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# web app (apps/web/lib/share.ts, T21b share pages) + functions only, never
# the extension. apps/web reads SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY
# straight from process.env at request time (Next.js server code, not a
# build-time inject like the extension's WXT_SUPABASE_* vars below); set
# them wherever the web app actually runs (apps/web/.env.local for local
# dev, or the host platform's env config in production).
SUPABASE_SERVICE_ROLE_KEY=
# AI organize (self-hosters use their own key)
ANTHROPIC_API_KEY=
# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=        # $4/mo price id
STRIPE_PRICE_YEARLY=         # $29/yr price id
# Web
NEXT_PUBLIC_SITE_URL=http://localhost:3000
